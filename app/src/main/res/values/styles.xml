<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_page</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <!-- Inner pages slide over the shell themselves (c001apk card stack), so they are
         translucent and own their animation. -->
    <style name="PageTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <!-- Liquid-glass popup menus -->
    <style name="PopupGlass" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:popupBackground">@drawable/bg_popup_glass</item>
        <item name="android:popupElevation">10dp</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>
</resources>
